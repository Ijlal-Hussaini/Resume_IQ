# ==============================================================================
# ResumeIQ - Environment Variables Configuration
# ==============================================================================

# LLM Providers (Both have generous Free Tiers)
# 1. Primary: Groq API Key (Get free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Secondary Fallback: Google Gemini API Key (Get free key at https://aistudio.google.com)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Active Provider Preference ('auto' | 'groq' | 'gemini')
PREFERRED_PROVIDER=auto

# Server & Networking
PORT=8000
HOST=0.0.0.0
DEBUG=false

# Frontend API Target (for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
